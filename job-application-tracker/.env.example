# Copy to .env and adjust. Never commit the real .env file.

# Where the SQLite database lives (default: storage/app.sqlite)
# DB_PATH=storage/app.sqlite

# Your timezone, so "today" and reminder dates are right (e.g. America/New_York, Europe/London, Asia/Singapore)
APP_TIMEZONE=UTC

# Email reminders (bin/send_reminders.php)
#   log  = write emails to storage/outbox.log (default, safe for local development)
#   mail = send with PHP's mail(); needs a working sendmail/SMTP on the machine
MAIL_MODE=log
MAIL_FROM=no-reply@example.com
APP_URL=http://localhost:8000
